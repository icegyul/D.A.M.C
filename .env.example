PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL=postgresql://damc:damc@localhost:5432/damc
DATA_DIR=./storage
# Unauthenticated access for the bundled dashboard. Only ever applies to requests
# that originate on this machine: a request arriving through a proxy or tunnel
# must present an API key regardless of this setting, so leaving it on cannot
# expose /v1 remotely. Set it to false to require a key even locally.
DAMC_DEV_MODE=true
DAMC_API_KEY_ADMIN=
# Cross-origin browser access. Empty = same-origin only, which is all the bundled
# dashboard needs. Use a comma-separated origin list to allow specific web apps,
# or "*" to allow any origin (only sensible when every request needs an API key).
CORS_ORIGIN=
# --- Large import limits -----------------------------------------------------
# A provider export is the biggest thing DAMC ingests. Uploads are streamed to a
# temp file and read one conversation at a time, so these caps bound disk and
# reject hostile archives — they are not what bounds memory.
#
# Largest single upload accepted by the web import (4 GiB default). Also reported
# on /health so the dashboard can name the real number in its error message.
DAMC_IMPORT_MAX_FILE_SIZE_BYTES=4294967296
# Keywords that file an imported conversation under a project of that name (and
# promote its prose from HISTORY to KNOWLEDGE). Comma-separated; empty disables it.
# Defaults to DAMC's own name. This used to be a hardcoded list of the developer's
# project names, which meant a shipped copy created projects named after a
# stranger's work in the user's own database.
DAMC_PROJECT_HINTS=damc
# Cap on bytes decompressed out of an uploaded ZIP (8 GiB default).
DAMC_IMPORT_MAX_UNCOMPRESSED_BYTES=8589934592
# ZIP-bomb guard: refuse an entry that decompresses more than this many times its
# compressed size. JSON compresses roughly 5-15x, so 200 is a wide margin.
DAMC_IMPORT_MAX_COMPRESSION_RATIO=200
# Conversations ingested per batch; also how often import progress is committed.
DAMC_IMPORT_BATCH_SIZE=25

# --- Claude export packages --------------------------------------------------
# Claude's "Export your data" hands you a manifest JSON listing category ZIPs
# behind single-use URLs. DAMC downloads them server-side, and because those URLs
# come from a file the user uploaded, fetching them is a server-side request
# forgery primitive unless the destination is constrained. This allowlist is that
# constraint, and it is applied to every redirect hop as well as the first
# request. Comma-separated; a value matches the host itself or any subdomain.
# Widen it only after observing where a real Claude download actually redirects.
DAMC_CLAUDE_DOWNLOAD_HOSTS=claude.ai
# Per-request timeout for one category download.
DAMC_CLAUDE_DOWNLOAD_TIMEOUT_MS=300000
# Where upload temp files go. Empty means <DATA_DIR>/tmp. Point this at a mounted
# volume with room for the largest upload you intend to accept.
DAMC_IMPORT_TEMP_DIR=

GITHUB_BACKUP_ENABLED=false
GITHUB_BACKUP_REPO=
GITHUB_BACKUP_BRANCH=main
GITHUB_BACKUP_REMOTE=origin
OBSIDIAN_VAULT_PATH=

# Remote MCP gateway (POST /mcp). Authentication is ALWAYS required there,
# regardless of DAMC_DEV_MODE.
# Public HTTPS origin shown in generated AI connection configs. Leave empty
# when the gateway is reached through the same host as the dashboard; set it
# (e.g. https://damc.example.com) when a proxy/tunnel publishes a different host.
DAMC_PUBLIC_URL=
# Requests per minute per API key on the remote gateway.
DAMC_MCP_RATE_LIMIT_PER_MINUTE=120
